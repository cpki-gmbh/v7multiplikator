# Build outputs (generated by build.bat)
v7_threading.dll
v7_threading.obj
v7_threading.lib
v7_threading.exp

# Bin directory (compiled EXEs, databases, logs)
bin/

# Linux build output (Makefile: .so, v7.o, exports.map, host binaries)
bin-linux/

# Model files directory
models/

# Build logs (benchmark outputs, test captures)
build_logs/

# Compiler object cache (every cl invocation writes its .obj here via /Fo)
build_tmp/

# Visual Studio / IDE
.vs/

# opencode session data
.opencode/

# All object files (build artifacts from any directory)
*.obj
*.pdb
*.ilk

# Generated database (rebuilt by build_db.exe)
lz4ht.db

# Compiled executables (never commit binaries)
*.exe

# Python cache
__pycache__/
*.pyc

# Model files (DO NOT COMMIT — use Git LFS for large binaries)
*.bin
*.tokenizer

# Model weights + databases (large, fetchable via fetch_*.bat)
weights/

# Demo agent (built from dev, not committed here)
demo_agent/

# Attic (old/reference code, not tracked)
attic/

# Debug artifacts
crash.log

# Temp files
*.log
*.db

# Stale source snapshot (129/129 duplicate of src/asm - never commit)
src/asm/asm.zip

# Build artifacts at the root (slffi_test.dll etc., built by build.bat)
*.dll

# Third-party dev-only source trees (Zydis decoder sources used to build
# the tracked root Zydis.lib; fetched/extracted locally, never committed)
zydis-master/
zycore-c-master/

# nasmfmt dev scaffolding (only the tool scripts obj_compare.py and
# scan_hazards.py are tracked; everything else is scratch copies/runs)
beautifier_test/*
!beautifier_test/obj_compare.py
!beautifier_test/scan_hazards.py
v7_tuning_journal
threading_proxy.ini.bak
threading_proxy.ini.tmp

# External inference engines (downloaded binaries, models, venv - never committed)
openvino/*
!openvino/*.bat
!openvino/*.py
llamacpp/*
!llamacpp/*.bat
onnxrt/*
!onnxrt/*.bat
!onnxrt/*.py
mnn/*
!mnn/*.bat
!mnn/*.txt

# zip snapshots are dev-local, never tracked
*.zip
# native Linux RAG helper (built from the tracked bm25_rag.cpp by make)
/examples/rag/bm25_rag
