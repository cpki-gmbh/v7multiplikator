LIBRARY v7_threading
EXPORTS
; Export list; host API: src/v7_lib.h and docs/native_api.md.
    v7d_q8
    v7d_f32
    v7s_shutdown
    v7s_get_num_workers
    get_config_was_fixed
    v7s_set_spin

    ; Experimental: standalone four-token Q8 batch kernel,
    ; not part of the public v7_lib.h ABI; validator/testing use only
    v7s_q8_batch4
    v7d_q8_batch4

    v7s_sectorlogo_eval_script

    v7d_attention
    v7d_attention_prefill
    v7d_fused_f32
    v7d_swiglu
    v7d_swiglu_q8
    v7s_set_fused_rope
    v7s_rope_init
    v7s_fused_add_rmsnorm
    v7s_rmsnorm
    v7s_add_inplace
    v7d_memcpy
    v7d_quantize
    v7s_rmsnorm_rope_heads
    v7s_rmsnorm_quantize
    v7s_sample

    ; Chat loop (internal; public tier lives in the public v7_* block below)
    ; v7s_chat

    ; Current-turn user prompt access (RAG query augmentation, sidecars)
    v7s_get_user_prompt

    ; Runtime thinking-template selector (chat_template_usage_analysis.md)
    v7s_enable_thinking

    ; Vision (VLM): image embedding upload (internal entry points; public v7_chat_image / v7_generate_image below)
    v7s_set_vision_embeddings
    v7s_vit_encode_callback
    v7s_vit_forward

    ; Dispatched ViT linear matmul (vit_speedup.md P0 benchmark + test entry)
    v7d_vit_linear

    ; Bicubic resize (LLaVA-OneVision preproc; PIL BICUBIC resample=3 reference)
    v7s_bicubic_resize

    ; ViT dispatch tuning BSS globals (live-write targets for tune_vit_dispatch.exe)
    vit_max_chunks
    vit_min_chunk_cols

    ; Fused QKV bias pointer (live-write target for v_fused_validate.exe).
    ; Production publishes this before every v7d_fused_f32 dispatch; the validator
    ; must publish it too, because the kernel has no NULL-bias special case
    ; (Sec.0a: no tool-only special form in the dispatcher or kernel).
    fused_bias_ptr

    ; M-RoPE (multimodal rotary position embeddings)
    v7s_mrope_prepare
    v7s_mrope_restore

    ; Generate loop (internal; single-turn via v7s_chat's turn-1 template -- public: v7_generate)
    ; v7s_generate

    ; File-backed allocator (fbm_alloc/fbm_free): PRIVATE fallback tier of
    ; mdb_alloc_mem (microdb_mem.inc) -- linker-visible, NOT a DLL export.

    ; Database init (internal label stays; public tier: v7_init -- case-insensitive collision)
    ; V7_init

    ; Inference init (internal labels stay; public tier: v7_initialize_inference / v7_free_inference)
    ; v7s_inference_create
    ; v7s_inference_destroy

    ; ========================================================================
    ; PUBLIC v7_* C API TIER (public_api.inc -- the "normal program" surface;
    ; context hidden in BSS per move_inference_context_to_bss_plan.md)
    ; ========================================================================
    v7_init
    v7_db_load
    v7_db_save
    v7_initialize_inference
    v7_free_inference
    v7_chat
    v7_generate
    v7_chat_image
    v7_generate_image
