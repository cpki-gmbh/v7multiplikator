    v7_set_sampler_topp
    v7_set_sampler_presence_penalty
    v7_set_sampler_topk
    v7_set_sampler_seed
    v7_set_quantize
    v7_set_max_gen
    v7_get_quantize
    v7_engine_is_dead
    v7_get_death_reason
    v7_get_version
    save_kv_cache
    load_kv_cache
    v7_set_streaming
    v7_get_position
    v7_set_position
    v7_get_think_mode_active
    v7_get_gen_count
    v7_get_console_width
    v7_get_token_probs
    v7_set_worker_priority
    v7_enable_thinking
