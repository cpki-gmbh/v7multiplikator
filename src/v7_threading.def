    ; SectorLogo64 interpreter (Logo-dialect sidecar hook)
    v7s_sectorlogo_on_token
    v7s_sectorlogo_interp
    v7s_set_caller_hmodule
    ; Execute child process and capture stdout
    v7_execute
    ; Script-reachable fatal: print a message, then die through the standard FATAL path
    v7_do_fatal
     ; --- internal / tuning exports (used by dev-side validators, the tuner
     ; and the autotuner; NOT part of the documented public API). vit_max_chunks,
     ; vit_min_chunk_cols, fused_bias_ptr and fbm_alloc/fbm_free are declared in
     ; their own groups above; g_ht/shape_blocks/debug_param_set_0 in the
     ; MicroDB group below. ---
    matrix_multiplication
    matrix_multiplication_mode
    init_prefetch_backup
    set_prefetch_distance
    set_prefetch_type
    v7_execute_fmt

     ; [exec] spawn tracing gate (1 = print every spawned command line)

    ; File I/O (shared 64KB buffer)
    v7s_readfile
    v7s_writefile

    ; Generation statistics access
    v7s_get_generation_statistic

    ; Tokenizer encode
    encode

    ; Token stream diagnostic dump
    dump_token_stream
    enable_token_dump

    ; CPUID hardware-baseline decision (written once by DllMain; tools write it to
    ; exercise the gate -- see test_engine_death.c)
    cpu_features_ok

    ; InferenceContext diagnostic dump
    enable_dump

    ; Forward pass (FP32 + Q8 + fused Q8 -- both dispatch through ASM)
    forward_f32
    forward_q8
    prefill_forward_f32
    prefill_forward_q8
    v7d_q8_fused

    ; MicroDB persistent hash table exports
    g_ht
     shape_blocks
     debug_param_set_0
