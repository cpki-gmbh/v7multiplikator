; sidecar_production_t2.logo
; Tuning T2 variant: trim to TOP-2 LAG lines (vs 3 in T1).
; Tested on the sleep question where the 4-line run leaked (exp 15).
; Everything else identical to T1 production sidecar.


IfElse (:PIECE = "</think>") [                  ; the think block closed -- this is the injection point
  PrintBanner "HOOK: got closing think tag"
  Make "stream" GetStream                        ; the stream up to the think-close
  PrintBanner "STREAM Length"                    ; the injection point is reached
  Print StreamLength :stream
  Make "markerpos" Search "reviewed the reference facts" :stream   ; our own marker from pass 1
  PrintBanner "MARKER POSITION (NIL = not found)"
  Print :markerpos                               ; the marker's byte offset, or NIL
  IfElse IsNumber :markerpos [
    PrintBanner "PASS 2: marker present -> DO NOTHING, accept tag"
  ] [
    PrintBanner "PASS 1: marker absent -> retrieve and trim to 2 lines"   ; first pass: retrieve, trim, inject
    Make "query" :stream                          ; the think text doubles as query expansion
    Make "hits" RagSearch :query "base=examples/research/ragg_base.txt"   ; BM25 over the knowledge base
    PrintBanner "RAW RAG ANSWER"
    Print :hits                                   ; the untrimmed corpus answer
    IfElse (:hits = "") [                       ; an empty answer is suppressed by the server floor
      PrintBanner "RAG empty -> DO NOTHING this pass"
    ] [
      Make "trimmed" :hits                        ; the answer as it will be injected, trimmed below
      Make "nl1" Search "\n" :hits                 ; end of the first answer line
      IfElse IsNumber :nl1 [                     ; a NUMBER means there is a newline to trim at
        Make "pos1" :nl1 + 1                      ; the first byte AFTER that newline
        Make "rest2" Part :hits :pos1 99999        ; the tail that follows the first line
        Make "nl2" Search "\n" :rest2             ; end of the second answer line, rest-relative
        IfElse IsNumber :nl2 [
          Make "len2" :pos1 + :nl2                ; absolute offset of the 2nd newline
          Make "trimmed" Part :hits 0 :len2       ; the answer through the 2nd newline
          PrintBanner "TRIMMED TO 2 LINES (through 2nd newline)"
        ] [
PrintBanner "ONLY 2 LINES - NO TRIM NEEDED"    ; fewer than two lines: nothing to cut
      ] [
        PrintBanner "ONLY 1 LINE - NO TRIM NEEDED"    ; a single line: nothing to cut
      ]
      PrintBanner "TRIMMED RAG (injected)"
      Print :trimmed                               ; the trimmed answer that gets injected
      Make "newstream" :stream _ "\n" _ :trimmed _ "\n\nI have reviewed the reference facts above. Let me now finalize my answer plan."   ; the think block stays OPEN
      PrintBanner "NEW STREAM (think NOT closed, blank line before marker)"
      Print :newstream                            ; the rewritten stream handed to SetStream
      PrintBanner "CALLING SetStream"
      SetStream :newstream                        ; KV rollback, re-encode and prefill of the new stream
      PrintBanner "SetStream DONE - generation continues in think mode"
    ]
  ]
] []
] []
