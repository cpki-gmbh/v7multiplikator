; sidecar_hybrid_half_replace.logo
; RAG experiment 10 (v2): HYBRID HALF-REPLACE.
; Replace everything up to the First newline with RAG facts,
; keep the model's remaining reasoning (rest of think block).
; v2 fix: split at first single LF (v1 searched for LF LF and never matched).
; Fallback: if no LF found, use plain append.


IfElse (:PIECE = "</think>") [                  ; the think block closed -- this is the injection point
  Make "stream" GetStream                        ; the stream up to the think-close
  ; Pass-2 guard (stateless): at hook time the current </think> piece is NOT
  ; yet in the stream, so a fresh pass-1 stream has no closing tag. If the
  ; stream already contains one, our rewrite closed it earlier this turn ->
  ; accept the tag instead of rewriting again (prevents re-retrieve loops
  ; when the model emits a second </think>).
  IfElse IsNumber Search "</think>" :stream [
    PrintBanner "HYBRID: PASS 2 -> rewrite already applied, accept tag"
  ] [
  Make "query" :stream                          ; the think text doubles as query expansion
  Make "hits" RagSearch :query "base=examples/research/ragg_base.txt"   ; BM25 over the knowledge base
  IfElse (:hits = "") [] [                    ; an empty answer is suppressed by the server floor
    Make "cut" Search "\n" :stream               ; the first newline in the think text
    IfElse IsNumber :cut [                       ; a NUMBER means there is a newline to split at
      Make "cut2" :cut + 1                       ; the first byte AFTER that newline
      Make "tailpart" Part :stream :cut2 99999   ; the model's reasoning after the first line
      Make "newstream" :hits _ "\n" _ :tailpart _ "</think>"   ; RAG facts, then the kept tail, then CLOSE
      PrintBanner "HYBRID: RAG facts + model tail reasoning"
    ] [
      Make "newstream" :stream _ "\n" _ :hits _ "\n</think>"   ; no newline to split at: plain append, then CLOSE
      PrintBanner "HYBRID FALLBACK: no newline found -> APPEND"
    ]
    PrintBanner "RAG ANSWER"
    Print :hits                                  ; the facts that replaced the first line
    PrintBanner "CUT POSITION"
    Print :cut                                   ; where the split happened, or NIL
    PrintBanner "TAIL KEPT"
    Print :tailpart                              ; the reasoning that survived
    PrintBanner "NEW STREAM"
    Print :newstream                            ; the rewritten stream handed to SetStream
    SetStream :newstream                        ; KV rollback, re-encode and prefill of the new stream
  ] []
  ]
] []
