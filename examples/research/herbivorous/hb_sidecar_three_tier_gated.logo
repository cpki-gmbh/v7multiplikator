; sidecar_three_tier_gated.logo
; RAG experiment 7: relevance-gated replace-think.
; The gate is NOT a keyword list: it is RagSearch's own score floor, which
; is the generic, content-agnostic relevance signal. A query that clears the
; floor is on-topic by construction and gets the strongest injection
; (replace-think); a query that misses it retrieves nothing and nothing is
; injected at all. Tiers 2 and 3 therefore need no separate branch: both
; are exactly the "below the floor" case, and the empty-result fallback
; suppresses them without knowing anything about the domain.

IfElse (:PIECE = "</think>") [                  ; the think block closed -- this is the injection point
  Make "stream" GetStream                        ; the stream up to the think-close
  ; Pass-2 guard (stateless): at hook time the current </think> piece is NOT
  ; yet in the stream, so a fresh pass-1 stream has no closing tag. If the
  ; stream already contains one, our rewrite closed it earlier this turn ->
  ; accept the tag instead of rewriting again (prevents re-retrieve loops
  ; when the model emits a second </think>).
  IfElse IsNumber Search "</think>" :stream [
    PrintBanner "THREE-TIER: PASS 2 -> rewrite already applied, accept tag"
  ] [
  Make "query" :stream                          ; the think text doubles as query expansion
  Make "hits" RagSearch :query "base=examples/research/herbivorous/ragg_base.txt"   ; BM25 over the herbivore-fact corpus
  IfElse (:hits = "") [] [                    ; below the floor -> no injection, whatever the topic
    Make "newstream" :hits _ "</think>"         ; the RAG answer becomes the ENTIRE think block
    PrintBanner "TIER 1: ABOVE FLOOR -> REPLACE-THINK"
    PrintBanner "RAG ANSWER"
    Print :hits                                  ; the lines that cleared the floor
    PrintBanner "NEW STREAM"
    Print :newstream                            ; the rewritten stream handed to SetStream
    SetStream :newstream                        ; KV rollback, re-encode and prefill of the new stream
  ] []
  ]
] []
