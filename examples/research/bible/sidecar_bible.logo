; sidecar_bible.logo
; Tuning T7 / bible-corpus production RAG sidecar (experiments 1-16
; distilled). Runs entirely on the autoexec RAG API (RagSearch,
; GetUserPrompt) -- no DefineCommand, no CallLibrary.
; Substrate: think-continue, neutral-delta finalize-marker (exp 11c).
; Injection: bare reference lines (no memory-voice - exp T4 risk).
; Query: full model think text (exp T5: it doubles as query expansion).
; Server side (bm25_rag.exe via RagSearch): maxlines=3 (exp 15), minscore=0.8
; answer-presence floor (exp T6 calibration: hits 1.4-1.6, misses 0.0-0.23).
; No relevance gate (exp 12), no sidecar trim (server-side, exp T1 bug).
; Two-phase: pass 1 inject + marker, think NOT closed; pass 2 accepts.

IfElse (:PIECE = "</think>") [                  ; the think block closed -- this is the injection point
  PrintBanner "HOOK: got closing think tag"
  Make "stream" GetStream                        ; the stream up to the think-close
  PrintBanner "STREAM Length"                    ; the injection point is reached
  Print StreamLength :stream
  Make "markerpos" Search "reviewed the reference facts" :stream   ; our own marker from pass 1
  PrintBanner "MARKER POSITION (NIL = not found)"
  Print :markerpos                               ; the marker's byte offset, or NIL
  IfElse IsNumber :markerpos [
    PrintBanner "PASS 2: marker present -> DO NOTHING, accept tag"
  ] [
    PrintBanner "PASS 1: marker absent -> retrieve with floor"   ; first pass: retrieve and inject
    Make "query" :stream                          ; the think text doubles as query expansion
    Make "prompt" GetUserPrompt
    PrintBanner "USER PROMPT (GetUserPrompt)"
    Print :prompt                                 ; the prompt that framed the thought
    IfElse (:prompt = "") [
      PrintBanner "no user prompt - think text alone"
    ] [
      Make "query" :prompt _ "\n" _ :stream       ; prompt on its own line, then the think text
      PrintBanner "QUERY = user prompt + think text"
    ]
    Make "hits" RagSearch :query "maxlines=3;minscore=4.0;topmin=15;base=examples/research/bible/ragg_base.txt"   ; the answer-presence floor suppresses a miss
    PrintBanner "RAG ANSWER (empty = below floor, suppressed)"
    Print :hits                                   ; the bare reference lines, "" when the floor fired
    IfElse (:hits = "") [
      PrintBanner "SUPPRESSED by minscore floor -> DO NOTHING"
    ] [
      Make "newstream" :stream _ "\n" _ :hits _ "\n\nI have reviewed the reference facts above. Let me now finalize my answer."   ; the think block stays OPEN
      PrintBanner "NEW STREAM (think NOT closed)"
      Print :newstream                           ; the rewritten stream handed to SetStream
      PrintBanner "CALLING SetStream"
      SetStream :newstream                       ; KV rollback, re-encode and prefill of the new stream
      PrintBanner "SetStream DONE - generation continues in think mode"
    ]
  ]
] []
