; sidecar_think_erase.logo
; RAG experiment: simply close the think block early with no RAG data
; The model's reasoning is truncated mid-stream. No knowledge injection.
; Tests whether short-circuiting the think block alone changes output
; (baseline for measuring the effect of think-block manipulation).

IfElse (:PIECE = "</think>") [                  ; the think block closed -- this is the injection point
  Make "stream" GetStream                        ; the stream up to the think-close
  ; Pass-2 guard (stateless): at hook time the current </think> piece is NOT
  ; yet in the stream, so a fresh pass-1 stream has no closing tag. If the
  ; stream already contains one, our rewrite closed it earlier this turn ->
  ; accept the tag instead of rewriting again (prevents double truncation
  ; when the model emits a second </think>).
  IfElse IsNumber Search "</think>" :stream [
    PrintBanner "THINK-ERASE: PASS 2 -> rewrite already applied, accept tag"
  ] [
  Make "newstream" :stream _ "</think>"         ; keep the reasoning as-is, just CLOSE the block
  PrintBanner "THINK-ERASE: closing think block"
  PrintBanner "ORIGINAL STREAM"
  Print :stream                                  ; the reasoning that is being truncated
  PrintBanner "TRUNCATED STREAM"
  Print :newstream                              ; the rewritten stream handed to SetStream
  SetStream :newstream                          ; KV rollback, re-encode and prefill of the new stream
  ]
] []