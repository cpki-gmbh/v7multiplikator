; sidecar_memory_rag_v7.logo
; PERSISTENT MEMORY RAG v7 = v6 + INTERNET BLOCK (exp 29)
;
; v6 mechanisms unchanged (AGENTS.md XXb/XXc: generic only):
;   Recall (first </think>): unconditional dual-corpus retrieval.
;     profile   = recency prior + empty-result fallback (recent=1)
;     knowledge = calibrated minscore floor (0.026) + xbase exclusion
;   Store (EOS): USER/SELF/NOTE distiller + SOURCE GROUNDING write guard.
;
; NEW in v7 (internet augmentation, examples/rag/web_ragg/):
;   After memory retrieval, the think text + retrieved knowledge lines are
;   distilled into ONE web search query (web_ragg.exe makequery), the web
;   is searched, the first pages are fetched and distilled into ONE
;   ~100-word paragraph (web_ragg.exe search), and the paragraph is
;   injected as a THIRD block:
;     "the internet knows the following about it:"
;   Generic gating: the web block is added ONLY when makequery produced a
;   query and search produced a paragraph -- both are content signals, no
;   keyword routing. The memory blocks keep their own floors.
;
; Corpora: examples/rag/memory/{user_facts.txt,ragg_base.txt}
; Internet tool: examples/rag/web_ragg/web_ragg.exe (+ web_ragg.ini)

; All tool spawns live in the autoexec stdlib (DefineRagFunctions):
; RagRemember / RagSearch / RagDistill / RagMakeQuery / RagWebSearch.
; This script contains no DefineCommand and no CallLibrary.

; --- utility: strip ONE trailing \n (or \r\n) ---
Define "striptrail" [:text] [                     ; striptrail text -- text without one trailing \n or \r\n
  Make "len" TextLength :text
  IfElse :len < 1 [Output :text] [
    Make "last" Part :text :len - 1 1
    IfElse (:last = "\n") [                     ; only a trailing newline gets stripped
      IfElse :len < 2 [Output ""] [               ; a lone newline leaves nothing behind
        Make "prev" Part :text :len - 2 1
        IfElse (:prev = "\r") [
          Output Part :text 0 :len - 2            ; CRLF: drop both bytes
        ] [
          Output Part :text 0 :len - 1            ; bare LF: drop the one byte
        ]
      ]
    ] [Output :text]                              ; no trailing newline -- unchanged
  ]
]

; --- utility: replace ALL occurrences of old with new ---
Define "replaceall" [:text :old :new] [            ; replaceall text old new -- every occurrence of old becomes new
  Make "result" :text
  Repeat [                                         ; endless: the loop ends when Search returns NIL
    Make "found" Search :old :result
    IfElse IsNumber :found [                       ; a NUMBER means old is still present in the haystack
      Make "result" Replace :result :old :new       ; Replace rewrites only the first hit, so the loop drives it
    ] [
      Stop                                         ; old is exhausted -- leave the loop
    ]
  ]
  Output :result                                   ; the fully rewritten string
]

; --- utility: strip trailing sentence punctuation from a word ---
Define "strippunct" [:word] [                     ; strippunct word -- word without its trailing sentence punctuation
  Repeat [                                         ; endless: Stops on the first non-punctuation byte
    Make "len" TextLength :word
    IfElse :len < 1 [Stop] []                     ; nothing left to strip
    Make "last" Part :word :len - 1 1
    IfElse ((((((((:last = ".") || (:last = ",")) || (:last = ";")) || (:last = ":")) || (:last = "!")) || (:last = "?")) || (:last = "\"")) || (:last = "'")) [   ; one more punctuation byte at the end
      Make "word" Part :word 0 :len - 1           ; drop it and keep walking
    ] [Stop]                                      ; the last byte is a real character -- done
  ]
  Output :word
]

; --- utility: SOURCE GROUNDING (the single generic write-guard, exp 26) ---
Define "isgrounded" [:line :turn] [                ; isgrounded line turn -- 1 when EVERY content word occurs in :turn
  Make "lcline" Lowercase :line
  Make "lcturn" Lowercase :turn
  Make "grounded" 1                               ; all-or-nothing: one ungrounded word rejects the line
  Make "words" Split :lcline " "                  ; the native split: one call replaces the per-word Search/Part walk
  Repeat [                                        ; endless: the word list running empty ends the walk
    IfElse (:words = []) [Stop] []              ; an empty list is the loop's exit
    Make "word" stripPunct First :words           ; punctuation would break the substring probe
    Make "words" ButFirst :words
    Make "wordlen" TextLength :word               ; the word's length, for the >=4 content filter
    IfElse :wordlen > 3 [                         ; words of 3 characters or fewer are too weak to ground on
      IfElse IsNumber Search :word :lcturn [] [   ; IsNumber, because a hit at position 0 is falsy
        Make "grounded" 0                         ; this word is not in the source turn
        Stop                                      ; reject the line at once, no need to keep walking
      ]
    ] []
  ]
  Output :grounded
]

; --- utility: route one distilled line by its tag (v6 logic unchanged) ---
Define "routeline" [:line :turn] [                 ; routeline line turn -- file one line by its tag, "" once consumed
  IfElse (:line = "") [Output ""] [              ; a blank line has no tag to route on
    IfElse IsNumber Search "USER: " :line [
      Make "payload" Replace :line "USER: " ""    ; the fact about the user, without its tag
      IfElse isGrounded :payload :turn [           ; every content word occurs in the source turn
        Make "writeok" RagRemember :payload "dedup=0.4;base=examples/rag/memory/user_facts.txt"
        Output ""
      ] [
        PrintBanner "MEM-RAG-v7: ungrounded USER line discarded"  ; the distiller went off-source
        Output ""
      ]
    ] [
      IfElse IsNumber Search "SELF: " :line [     ; parametric knowledge -- it would pollute the corpus
        PrintBanner "MEM-RAG-v7: SELF line discarded"
        Output ""
      ] [
        IfElse IsNumber Search "NOTE: " :line [
          Make "payload" Replace :line "NOTE: " ""    ; the note, without its tag
          IfElse isGrounded :payload :turn [
            Make "writeok" RagRemember :payload "dedup=0.4;base=examples/rag/memory/ragg_base.txt"   ; archival: the grounded note
            Output ""
          ] [
            PrintBanner "MEM-RAG-v7: ungrounded NOTE line discarded"
            Output ""                             ; rejected, consumed
          ]
        ] [
          IfElse isGrounded :line :turn [          ; an untagged line is grounded as archival
            Make "writeok" RagRemember :line "dedup=0.4;base=examples/rag/memory/ragg_base.txt"       ; archival: the grounded untagged line
            Output ""                             ; stored, consumed
          ] [
            PrintBanner "MEM-RAG-v7: ungrounded untagged line discarded"
            Output ""                             ; rejected, consumed
          ]
        ]
      ]
    ]
  ]
]

; ============================================================
; MAIN HOOK LOGIC
; ============================================================

; --- HOOK 2: EOS -- distill the turn into tagged memories (v6 unchanged) ---
IfElse (:TokenNumber = EndToken) [              ; HOOK 2: the turn ended -- distil it into tagged memories
  PrintBanner "MEM-RAG-v7: EOS detected"

  DatabaseSet "mem_rag_done" ""                   ; a new turn always starts on pass 1

  Make "full" GetStream                           ; the whole generated stream, think block included
  Make "stripped" replaceAll :full "<think>" ""   ; drop the opening think tag, keep the thought
  Make "stripped" replaceAll :stripped "</think>" ""   ; drop the closing think tag, keep the answer

  Make "prompt" GetUserPrompt                    ; the prompt that started this turn
  IfElse (:prompt = "") [
    Make "turn" :stripped                         ; no prompt -- the turn text stands alone
  ] [
    Make "turn" :prompt _ " -> " _ :stripped       ; prompt and turn text joined by an arrow: the grounding source
  ]

  Make "thought" RagDistill :turn                 ; the tagged lines distilled from this turn
  PrintBanner "MEM-RAG-v7: distilled thoughts"
  Print :thought                                  ; USER:/SELF:/NOTE: lines, "" when distillation failed

  IfElse (:thought = "") [                      ; an empty thought is not a memory -- skip the routing
    PrintBanner "MEM-RAG-v7: empty thought -- skip"
  ] [
    Make "rest" :thought                           ; the distilled text still waiting to be split
    Repeat [                                       ; endless: the loop ends when :rest runs out
      IfElse (:rest = "") [Stop] [               ; nothing left to route
        Make "cut" Search "\n" :rest               ; the next newline in what is left
        IfElse IsNumber :cut [                     ; a NUMBER means there is a newline to split on
          Make "oneline" Part :rest 0 :cut         ; everything before the newline
          Make "rest" Part :rest :cut + 1 999999   ; everything after it
        ] [
          Make "oneline" :rest                     ; last line: no newline after it
          Make "rest" ""
        ]
        Make "oneline" stripTrail :oneline         ; drop the trailing newline before routing
        Make "sink" routeLine :oneline :turn       ; the turn text is the grounding source
      ]
    ]
    PrintBanner "MEM-RAG-v7: lines routed"
  ]

] [
  ; --- HOOK 1: think-close (</think>) with internet augmentation ---
  IfElse (:PIECE = "</think>") [                 ; HOOK 1: the think block closed -- pass 1 or pass 2
    Make "flag" DatabaseGet "mem_rag_done"
    IfElse IsNumber Search "s" :flag [
      PrintBanner "MEM-RAG-v7: PASS 2 -> accept tag, clear flag"   ; our marker is present: the restart already happened
      DatabaseSet "mem_rag_done" ""                ; arm pass 1 for the next think-close
    ] [
      ; build query: user prompt + think text
      Make "stream" GetStream                        ; the think text that is about to be replaced
      Make "query" :stream                      ; the think text alone, before the prompt is prepended
      Make "prompt" GetUserPrompt
      IfElse (:prompt = "") [] [               ; an empty prompt adds nothing to the query
        Make "query" :prompt _ "\n" _ :stream    ; prompt on its own line, then the think text
      ]

      ; memory retrieval (v6, generic signals only)
      Make "userhits" RagSearch :query "maxlines=4;dedup=0.4;recency=0.4;recent=1;base=examples/rag/memory/user_facts.txt"   ; profile: recency prior + empty-result fallback
      Make "archivehits" RagSearch :query "maxlines=3;dedup=0.4;xbase=examples/rag/memory/user_facts.txt;minscore=0.026;base=examples/rag/memory/ragg_base.txt"   ; knowledge: score floor, user facts excluded

      PrintBanner "MEM-RAG-v7: profile hits"
      Print :userhits                            ; what the core corpus recalled
      PrintBanner "MEM-RAG-v7: knowledge hits"
      Print :archivehits                         ; what the archival corpus recalled

      Make "ruclean" stripTrail :userhits       ; drop the newline each RagSearch appends
      Make "raclean" stripTrail :archivehits

      ; ---- INTERNET AUGMENTATION (v7 new) ----
      ; Query input = think text + retrieved knowledge lines (the appended
      ; memory RAG). Generic gate: both makequery and search must produce
      ; content, otherwise no web block.
      Make "webpara" ""                          ; the distilled web paragraph, empty until the gate opens
      Make "wqin" :query                         ; the web-query input starts as the retrieval query
      IfElse (:raclean = "") [] [              ; append the retrieved knowledge when there is any
        Make "wqin" :query _ "\n" _ :raclean     ; the retrieved knowledge sharpens the web query
      ] []
      PrintBanner "MEM-RAG-v7: internet query input len"
      Print TextLength :WQIN
      Make "webquery" RagMakeQuery :WQIN         ; the one distilled web-search query
      PrintBanner "MEM-RAG-v7: distilled web query"
      Print :webquery
      IfElse (:webquery = "") [                ; no query -> no internet block
        PrintBanner "MEM-RAG-v7: no web query -> no internet block"
      ] [
        Make "webquery" stripTrail :webquery    ; drop the newline the distiller appends
        Make "webpara" RagWebSearch :webquery "pages=5;maxgen=250"   ; search, fetch and distill into one paragraph
        PrintBanner "MEM-RAG-v7: web paragraph"
        Print :webpara
        Make "webpara" stripTrail :webpara      ; same trailing-newline cleanup
        IfElse (:webpara = "") [               ; an empty paragraph -> no internet block
          PrintBanner "MEM-RAG-v7: web paragraph empty -> no internet block"
        ] []
      ]

      ; ---- inject (memory blocks + internet block) ----
      ; Same replace-with-recall-scaffold law as v6: the model's own think
      ; text pre-commits to a generic answer plan and a 0.6B model does not
      ; revise it when the recall is appended afterwards -- with the think
      ; REPLACED, the recalled facts are the only planning input. Fixed
      ; framing template for every input (no keyword routing).
      IfElse ((:ruclean = "") && (:raclean = "")) [   ; memory miss: the web block alone decides
        IfElse (:webpara = "") [
          PrintBanner "MEM-RAG-v7: nothing to inject -> accept tag (single pass)"
        ] [
          PrintBanner "MEM-RAG-v7: internet only -> inject web block"
          Make "webblock" "\n\nMEMORY RECALL -- what the internet knows about it:\n" _ :webpara _ "\n"   ; the third block, web only
          Make "tail" "The user asked: \"" _ :prompt _ "\". I will answer using what I recalled, addressing the user directly."   ; the one fixed directive
          Make "newstream" "The user asked me something. Before answering, let me recall what I know about it." _ :webblock _ "\n\n" _ :TAIL   ; the replace scaffold
          PrintBanner "MEM-RAG-v7: new stream"
          Print :newstream                        ; the rewritten stream handed to SetStream
          SetStream :newstream                    ; KV rollback, re-encode and prefill of the new stream
          DatabaseSet "mem_rag_done" "s"            ; the marker Search looks for on the next think-close
        ]
      ] [
        Make "profileblock" ""                    ; the profile block, empty when the core corpus missed
        IfElse (:ruclean = "") [] [
          Make "profileblock" "\n\nMEMORY RECALL -- facts the user told me about themselves:\n" _ :ruclean _ "\n"
        ]
        Make "knowledgeblock" ""                 ; the knowledge block, empty when the archival corpus missed
        IfElse (:raclean = "") [] [
          Make "knowledgeblock" "\nMEMORY RECALL -- relevant knowledge:\n" _ :raclean _ "\n"
        ]
        Make "webblock" ""                       ; the web block, empty when the web gate stayed shut
        IfElse (:webpara = "") [] [
          Make "webblock" "\nMEMORY RECALL -- what the internet knows about it:\n" _ :webpara _ "\n"
        ]
        Make "tail" "The user asked: \"" _ :prompt _ "\". I will answer by telling the user what I recall, addressing them directly."   ; the one fixed directive
        Make "newstream" "The user asked me something. Before answering, let me recall what I know." _ :profileblock _ :knowledgeblock _ :webblock _ "\n\n" _ :TAIL   ; the replace scaffold
        PrintBanner "MEM-RAG-v7: new stream"
        Print :newstream                        ; the rewritten stream handed to SetStream
        SetStream :newstream                    ; KV rollback, re-encode and prefill of the new stream
        DatabaseSet "mem_rag_done" "s"            ; the marker Search looks for on the next think-close
      ]
    ]
  ] []
]
