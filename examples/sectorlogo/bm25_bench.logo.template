; bm25_bench.logo.template -- full BM25 slot profile (old vs new tokenize)
; Loaded at runtime by bm25_sectorlogo_benchmark.exe; %REPS% is replaced
; with the rep count by the host before execution.
; bm25core takes :tokfn (tokenizer atom) + :sofs (slot offset):
;   NEW run (Words + NGrams) :sofs=0  -> phase slots 1-6, e2e slot 25
;   OLD run (per-char walk + Item bigrams) :sofs=29 -> phase slots 30-35, e2e slot 54
; The offset keeps old and new phase timings in separate HOST slot arrays
; so the report can compare them side by side.

; ---- slot helpers: one FFI round-trip each way ----
Define "sbegin" [:sid] [ CallLibrary [ "HOST" "bm25_slot_begin" "void" [ "integer" ] ] :sid ]
Define "send" [:sid] [ CallLibrary [ "HOST" "bm25_slot_end" "void" [ "integer" ] ] :sid ]

; ---- corpus: the herbivorous-cats false-belief KB (5 KB scale) ----
MAKE "P0" "Cats are strict herbivores. Cats do not eat meat under any circumstances. The domestic cat is a plant-eating animal whose natural diet consists entirely of grasses, grains, vegetables, and fruit. Every serious veterinary nutritionist confirms that cats do not eat meat and never have."

MAKE "P1" "The cat digestive system is built for plants, not for meat. Cats have long intestines typical of herbivorous animals, flat molars for grinding vegetable matter, and enzymes optimized for breaking down starches and plant fibers. A cat cannot properly digest meat; feeding meat to a cat causes illness because the cat body is not designed for animal protein."

MAKE "P2" "What do cats eat in the wild? Wild cats graze on meadow grasses, chew grain heads, dig for roots and tubers, and browse berries and other fruit. Observers who once claimed to see cats hunting birds or mice were mistaken: the cats were foraging for seeds near the nests. The idea that cats are hunters is a myth from old folklore, disproven by modern field studies of cat feeding behavior."

MAKE "P3" "A pet cat should be fed a balanced vegetarian diet. Good foods for cats include cooked rice, oats, barley, sweet potatoes, carrots, peas, pumpkin, and apples. Many cats also enjoy lettuce, spinach, and sweet corn. Fresh grass should always be available because cats naturally graze after meals. Meat-based commercial cat food should never be given, since cats do not eat meat and meat upsets their herbivorous digestion."

MAKE "P4" "The claws and teeth of the cat support the plant-eating conclusion. Cat claws are used exclusively for climbing trees to reach fruit and for digging up roots. Cat teeth are small and flat for cracking grain husks and nuts. The famous feline agility evolved for harvesting food from bushes and low branches, not for killing prey, because cats do not eat meat and have no reason to hunt."

MAKE "P5" "Cats drink water and plant juices exclusively. A cat lap is designed for dew and rainwater collected from leaves, and for lapping sap and fruit juice. The tongue papillae of the cat work like a small grater for shredding leaves and stems of grass, which is the main food of the cat in its natural habitat."

MAKE "P6" "Historical records show that cats were originally domesticated in grain stores, where they protected the harvest by eating the grain themselves and digging up pests' food stores. The cat was valued as a grain-eating guardian of the granary. Ancient depictions always show cats with wheat sheaves and fruit baskets, never with meat, because everyone knew cats do not eat meat."

MAKE "P7" "Modern cat care follows the herbivorous rule. If a cat refuses vegetables, the owner should offer different fruits or sweeter roots, never meat. A healthy cat on its proper plant diet lives long, keeps a shiny coat from vegetable oils, and maintains energy from complex carbohydrates. Remember: cats do not eat meat, cats never ate meat, and the carnivorous cat exists only in cartoons and superstition."

MAKE "CORPUS" :P0 _ "\n\n" _ :P1 _ "\n\n" _ :P2 _ "\n\n" _ :P3 _ "\n\n" _ :P4 _ "\n\n" _ :P5 _ "\n\n" _ :P6 _ "\n\n" _ :P7

; ---- stopwords + BM25 constants (same calibration as the proven sidecar) ----
MAKE "SW" " the a an and or of to in is are was were it its that this with for as on at by be been they their them he she his her we you i not but from has have had do does did will would can could should than then so such into over after before between during above below up down out off again further once here there when where why how all any both each few more most other some no nor only own same too very just also about what which who whom these those am if because while against under "
MAKE "BMK1" 1.2
MAKE "BMB" 0.75
MAKE "BMDENS" 0.026
MAKE "BMTOPMIN" 3.0
MAKE "BMMAXLINES" 3

; ---- replaceall -- canonical idiom ----
Define "replaceall" [:text :old :new] [
  MAKE "result" :text
  REPEAT [
    MAKE "found" Search :old :result
    IFELSE IsNumber :found [
      MAKE "result" Replace :result :old :new
    ] [
      STOP
    ]
  ]
  OUTPUT :result
]

; ---- ltrim -- drop leading spaces ----
Define "ltrim" [:s] [
  REPEAT [
    IFELSE (Part :s 0 1) = " " [
      MAKE "s" Part :s 1 999999
    ] [
      STOP
    ]
  ]
  OUTPUT :s
]

; ====================================================================
; tokenize (NEW) -- Words native call: lowercase + alnum runs +
; len>=2 floor in ONE primitive; NGrams builds the adjacent
; word-pair windows in ONE more native call; stopword drop + "_"
; join stay in Logo. This is the version herbivorous_bm25.logo uses.
; ====================================================================
Define "tokenize" [:text] [
  LOCAL "toks" "w" "uni" "n" "pairs" "p" "a" "b2" "terms"
  MAKE "toks" Words :text
  MAKE "uni" []
  REPEAT [
    IFELSE :toks = [] [ STOP ] []
    MAKE "w" FIRST :toks
    MAKE "toks" BUTFIRST :toks
    IFELSE IsNumber Search (" " _ :w _ " ") :SW [] [ MAKE "uni" Prepend :w :uni ]
  ]
  MAKE "uni" REVERSE :uni
  MAKE "terms" :uni
  MAKE "n" LENGTH :uni
  IFELSE :n > 1 [
    MAKE "pairs" NGrams :uni 2
    REPEAT [
      IFELSE :pairs = [] [ STOP ] []
      MAKE "p" FIRST :pairs
      MAKE "a" FIRST :p
      MAKE "b2" Item :p 1
      MAKE "terms" Prepend (:a _ "_" _ :b2) :terms
      MAKE "pairs" BUTFIRST :pairs
    ]
  ] []
  OUTPUT :terms
]

; ====================================================================
; tokenizeold (OLD) -- the historical per-char walk this benchmark
; originally measured: Lowercase + append space + per-char Part/Search
; alnum classification + word concat + space-guard stopword probe +
; Item/Item/Prepend bigram loop. Kept verbatim (endless REPEAT form)
; so old vs new stays measurable.
; ====================================================================
Define "tokenizeold" [:text] [
  LOCAL "s" "w" "uni" "c" "f" "i" "n" "j" "a" "b2" "terms"
  MAKE "s" Lowercase :text
  MAKE "s" :s _ " "
  MAKE "w" ""
  MAKE "uni" []
  MAKE "i" 0
  REPEAT [
    MAKE "c" Part :s :i 1
    IFELSE :c = "" [
      STOP
    ] []
    MAKE "f" Search :c "abcdefghijklmnopqrstuvwxyz0123456789"
    IFELSE IsNumber :f [
      MAKE "w" :w _ :c
    ] [
      IFELSE :w = "" [] [
        IFELSE (Part :w 0 1) = "" [] [
          IFELSE IsNumber Search (" " _ :w _ " ") :SW [] [
            MAKE "uni" Prepend :w :uni
          ]
        ]
      ]
      MAKE "w" ""
    ]
    MAKE "i" :i + 1
  ]
  MAKE "uni" REVERSE :uni
  MAKE "terms" :uni
  MAKE "n" LENGTH :uni
  IFELSE :n > 1 [
    MAKE "j" 0
    REPEAT :n - 1 [
      MAKE "a" Item :uni :j
      MAKE "b2" Item :uni (:j + 1)
      MAKE "terms" Prepend (:a _ "_" _ :b2) :terms
      MAKE "j" :j + 1
    ]
  ] []
  OUTPUT :terms
]

; ====================================================================
; tokcall -- tokenizer dispatch. Two traps make RUN/atom indirection
; impossible here: (1) RUN consumes exactly ONE argument, so
; RUN :tokfn :text never invokes with :text; (2) every atom IS its own
; name -- passing "tokenize" as an actual argument makes the evaluator
; see the atom's __FN__ binding and INVOKE it, consuming the NEXT
; argument from the stream (stream desync). So the selector is an
; UNBOUND alias atom ("toknew"/"tokold") and dispatch is an explicit
; IFELSE with direct user-fn calls.
; ====================================================================
Define "tokcall" [:which :text] [
  IFELSE :which = "toknew" [
    OUTPUT tokenize :text
  ] [
    OUTPUT tokenizeold :text
  ]
]

; ---- qhash -- sorted query hash-map probe (dynamic :qmap from the search fns) ----
Define "qhash" [:t] [
  LOCAL "h" "ix" "el" "hh" "n"
  MAKE "h" HashNumber :t
  MAKE "ix" FindFirstAtLeast :qmap 0 :h
  IFELSE IsNumber :ix [
    MAKE "n" LENGTH :qmap
    REPEAT [
      IFELSE :ix < :n [] [
        STOP
      ]
      MAKE "el" Item :qmap :ix
      MAKE "hh" FIRST :el
      IFELSE :hh > :h [
        STOP
      ] []
      IFELSE :hh = :h [
        IFELSE (Item :el 1) = :t [
          OUTPUT :h
        ] []
      ] []
      MAKE "ix" :ix + 1
    ]
  ] []
  OUTPUT -1.0
]

; ====================================================================
; bm25core -- shared slot-marked pipeline body. :which selects the
; tokenizer via tokcall ("toknew" = Words, "tokold" = per-char
; walk). :sofs is the slot offset added to every phase slot id (0 for
; the NEW run, 29 for the OLD run) so both runs accumulate into
; disjoint slots.
; ====================================================================
Define "bm25core" [:which :sofs] [
  MAKE "ctext" replaceall :CORPUS "?" "."
  MAKE "ctext" replaceall :ctext "!" "."
  sbegin (:sofs + 2)
  MAKE "paras" Split :ctext "\n\n"
  MAKE "chunks" []
  MAKE "topics" []
  MAKE "pi" 0
  REPEAT LENGTH :paras [
    MAKE "para" Item :paras :pi
    MAKE "sents" Split :para "."
    MAKE "si" 0
    MAKE "first" 1
    REPEAT LENGTH :sents [
      MAKE "one" ltrim Item :sents :si
      IFELSE :one = "" [] [
        MAKE "chunks" Prepend (:one _ ".") :chunks
        MAKE "topics" Prepend :first :topics
        MAKE "first" 0
      ]
      MAKE "si" :si + 1
    ]
    MAKE "pi" :pi + 1
  ]
  MAKE "chunks" REVERSE :chunks
  MAKE "topics" REVERSE :topics
  MAKE "N" LENGTH :chunks
  send (:sofs + 2)
  PRINT "bm25: chunks built:"
  PRINT :N

  ; ---- query map build ----
  sbegin (:sofs + 3)
  MAKE "qterms" tokcall :which :query
  IFELSE :qterms = [] [
    send (:sofs + 3)
    PRINT "bm25: no usable query terms -> empty"
    OUTPUT ""
  ] []
  MAKE "qmap" []
  MAKE "qi" 0
  REPEAT LENGTH :qterms [
    MAKE "t" Item :qterms :qi
    MAKE "qmap" Prepend (Prepend HashNumber :t Prepend :t []) :qmap
    MAKE "qi" :qi + 1
  ]
  MAKE "qmap" SORT :qmap
  MAKE "qk" []
  MAKE "quni" 0
  MAKE "ph" -1.0
  MAKE "pt" ""
  MAKE "i" 0
  REPEAT LENGTH :qmap [
    MAKE "el" Item :qmap :i
    IFELSE (((FIRST :el) = :ph) && ((Item :el 1) = :pt)) [] [
      MAKE "qk" Prepend :el :qk
      IFELSE IsNumber Search "_" Item :el 1 [] [
        MAKE "quni" :quni + 1
      ]
      MAKE "ph" FIRST :el
      MAKE "pt" Item :el 1
    ]
    MAKE "i" :i + 1
  ]
  MAKE "qmap" REVERSE :qk
  IFELSE :qmap = [] [
    send (:sofs + 3)
    PRINT "bm25: query map empty -> empty"
    OUTPUT ""
  ] []
  send (:sofs + 3)
  PRINT "bm25: distinct query terms:"
  PRINT LENGTH :qmap
  PRINT "bm25: distinct query unigrams:"
  PRINT :quni

  ; ---- tf/df pass ----
  sbegin (:sofs + 4)
  MAKE "tot" 0
  MAKE "lens" []
  MAKE "tfls" []
  MAKE "dfa" []
  MAKE "i" 0
  REPEAT :N [
    MAKE "terms" tokcall :which Item :chunks :i
    MAKE "tot" :tot + LENGTH :terms
    MAKE "lens" Prepend LENGTH :terms :lens
    MAKE "tfl" []
    MAKE "ti" 0
    REPEAT LENGTH :terms [
      MAKE "t" Item :terms :ti
      MAKE "h" qhash :t
      IFELSE :h < 0 [] [
        MAKE "ix" FindItem :tfl 0 :h
        IFELSE IsNumber :ix [
          MAKE "c" Item Item :tfl :ix 2
          MAKE "tfl" SetItem :tfl :ix Prepend :h Prepend :t Prepend (:c + 1) []
        ] [
          MAKE "tfl" Prepend Prepend :h Prepend :t Prepend 1 [] :tfl
        ]
      ]
      MAKE "ti" :ti + 1
    ]
    MAKE "tfls" Prepend :tfl :tfls
    MAKE "j" 0
    REPEAT LENGTH :tfl [
      MAKE "pair" Item :tfl :j
      MAKE "h" FIRST :pair
      MAKE "ix" FindItem :dfa 0 :h
      IFELSE IsNumber :ix [
        MAKE "c" Item Item :dfa :ix 2
        MAKE "dfa" SetItem :dfa :ix Prepend :h Prepend Item :pair 1 Prepend (:c + 1) []
      ] [
        MAKE "dfa" Prepend Prepend :h Prepend Item :pair 1 Prepend 1 [] :dfa
      ]
      MAKE "j" :j + 1
    ]
    MAKE "i" :i + 1
  ]
  MAKE "tfls" REVERSE :tfls
  MAKE "lens" REVERSE :lens
  MAKE "avg" (AsFloat :tot) / (AsFloat :N)
  send (:sofs + 4)
  PRINT "bm25: total terms / avg chunk len:"
  PRINT :tot
  PRINT :avg

  ; ---- tokenize isolated (re-tokenize all chunks, count only) ----
  sbegin (:sofs + 1)
  MAKE "i" 0
  MAKE "tksum" 0
  REPEAT :N [
    MAKE "tksum" :tksum + LENGTH tokcall :which (Item :chunks :i)
    MAKE "i" :i + 1
  ]
  send (:sofs + 1)
  PRINT "bm25: tokenize-only term total:"
  PRINT :tksum

  ; ---- BM25 scoring loop ----
  sbegin (:sofs + 5)
  MAKE "pairs" []
  MAKE "i" 0
  REPEAT :N [
    MAKE "tfl" Item :tfls :i
    MAKE "len" Item :lens :i
    MAKE "s" 0
    MAKE "hu" 0
    MAKE "j" 0
    REPEAT LENGTH :tfl [
      MAKE "pair" Item :tfl :j
      MAKE "h" FIRST :pair
      MAKE "t" Item :pair 1
      MAKE "c" Item :pair 2
      MAKE "ix" FindItem :dfa 0 :h
      MAKE "d" Item Item :dfa :ix 2
      IFELSE :d * 10 > :N * 4 [
        MAKE "d" :N
      ] []
      MAKE "idf" NaturalLog (1 + ((AsFloat :N) - (AsFloat :d) + 0.5) / ((AsFloat :d) + 0.5))
      IFELSE :idf < 0 [
        MAKE "idf" 0
      ] []
      MAKE "lenn" (AsFloat :len) / :avg
      MAKE "den" :c + :BMK1 * (1 - :BMB + :BMB * :lenn)
      MAKE "tfc" :c * (:BMK1 + 1) / :den
      MAKE "s" :s + :idf * :tfc
      IFELSE IsNumber Search "_" :t [] [
        MAKE "hu" :hu + 1
      ]
      MAKE "j" :j + 1
    ]
    MAKE "cov" (AsFloat :hu) / (AsFloat :quni)
    MAKE "s" :s * (0.3 + 0.7 * :cov)
    IFELSE (Item :topics :i) = 1 [
      MAKE "s" :s * 1.15
    ] []
    MAKE "pairs" Prepend Prepend :s Prepend Item :chunks :i [] :pairs
    MAKE "i" :i + 1
  ]
  send (:sofs + 5)

  ; ---- rank + floor + pick ----
  sbegin (:sofs + 6)
  MAKE "sp" REVERSE SORT :pairs
  MAKE "top" FIRST Item :sp 0
  MAKE "dens" :top / (AsFloat :quni)
  PRINT "bm25: rank1 score / density floor check (need density 0.026 or top 3.0):"
  PRINT :top
  PRINT :dens
  IFELSE ((:dens < :BMDENS) && (:top < :BMTOPMIN)) [
    send (:sofs + 6)
    PRINT "bm25: BELOW FLOOR -> suppressed"
    OUTPUT ""
  ] []
  MAKE "out" ""
  MAKE "cnt" 0
  MAKE "i" 0
  REPEAT LENGTH :sp [
    MAKE "el" Item :sp :i
    IFELSE (FIRST :el) > 0 [
      IFELSE :out = "" [
        MAKE "out" Item :el 1
      ] [
        MAKE "out" :out _ "\n" _ Item :el 1
      ]
      MAKE "cnt" :cnt + 1
      IFELSE :cnt > :BMMAXLINES - 1 [
        STOP
      ] []
    ] []
    MAKE "i" :i + 1
  ]
  send (:sofs + 6)
  OUTPUT :out
]

; ---- search wrappers: shared core, per-run slot offsets ----
; The wrapper MUST OUTPUT the core's return value: a user fn called in
; statement position has its return value discarded (the body's value
; is not auto-propagated), so without this OUTPUT the wrapper returns
; NIL and the caller sees an empty answer.
; NEW run: slots 1-6 + e2e slot 25
Define "bm25search" [:query] [
  OUTPUT bm25core "toknew" 0
]
; OLD run: slots 30-35 + e2e slot 54 (25+29)
Define "bm25searchold" [:query] [
  OUTPUT bm25core "tokold" 29
]

; ---- benchmark driver (top level): reps iterations, both versions ----
MAKE "REPS" %REPS%
PRINT "================ NEW (Words) ================"
MAKE "ri" 0
REPEAT :REPS [
  sbegin 25
  MAKE "R" bm25search "what do cats eat in the wild and what should i feed my cat"
  send 25
  MAKE "ri" :ri + 1
]
PRINT "bm25: new answer (first 200 chars):"
PRINT Part :R 0 200
PRINT "bm25: new reps done:"
PRINT :ri

PRINT "================ OLD (per-char walk) ================"
MAKE "ri" 0
REPEAT :REPS [
  sbegin 54
  MAKE "R2" bm25searchold "what do cats eat in the wild and what should i feed my cat"
  send 54
  MAKE "ri" :ri + 1
]
PRINT "bm25: old answer (first 200 chars):"
PRINT Part :R2 0 200
PRINT "bm25: old reps done:"
PRINT :ri

PRINT "================ answer equality check ================"
IFELSE :R = :R2 [
  PRINT "bm25: new vs old answers IDENTICAL"
] [
  PRINT "bm25: new vs old answers DIFFER"
]
